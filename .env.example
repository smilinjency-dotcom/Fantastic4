# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Exposed to the browser via Vite (must be prefixed VITE_)
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ── Cron authentication ──────────────────────────────────────────────────────
# Set to any strong random string (e.g. openssl rand -hex 32).
# Used to authenticate scheduled HTTP cron requests to server routes.
CRON_SECRET="YOUR_STRONG_RANDOM_SECRET"
# Optional: set to the previous value during secret rotation to avoid downtime.
# CRON_SECRET_PREVIOUS="PREVIOUS_SECRET"
